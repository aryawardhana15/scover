# Database Connection Configuration
# Copy file ini ke .env.local dan isi dengan kredensial database Anda dari DBeaver

# ============================================
# PILIH SALAH SATU: PostgreSQL ATAU MySQL
# ============================================

# Untuk PostgreSQL (uncomment dan isi):
DATABASE_URL=postgresql://username:password@localhost:5432/database_name
DATABASE_TYPE=postgresql

# Untuk MySQL (uncomment dan isi):
# DATABASE_URL=mysql://username:password@localhost:3306/database_name
# DATABASE_TYPE=mysql

# ============================================
# CARA MENDAPATKAN CONNECTION STRING:
# ============================================
# 1. Buka DBeaver
# 2. Klik kanan pada connection → "Edit Connection"
# 3. Lihat informasi:
#    - Host: localhost (atau IP server)
#    - Port: 5432 (PostgreSQL) atau 3306 (MySQL)
#    - Database: nama database Anda
#    - Username: username Anda
#    - Password: password Anda
#
# Format:
# postgresql://[username]:[password]@[host]:[port]/[database]
# mysql://[username]:[password]@[host]:[port]/[database]
#
# Contoh:
# DATABASE_URL=postgresql://postgres:mypassword@localhost:5432/quiz_psikotes
# DATABASE_URL=mysql://root:mypassword@localhost:3306/quiz_psikotes
# ============================================

# Optional: API URL (default: /api/quiz)
NEXT_PUBLIC_API_URL=/api/quiz

